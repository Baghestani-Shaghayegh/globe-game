# Supabase project: worldguess (ap-northeast-1)
#
# Both values are meant to be public — the publishable key only ever grants
# what row-level security allows, which is why it can ship in the bundle.
# Anything that must stay secret (the service role key) never appears here.
VITE_SUPABASE_URL=https://mqtijcesydoxntubwfdh.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_yYu-L4qcvmeEV2CUgOu4BQ_jpSkeeSA

# AdSense. Left empty on purpose: with no publisher id the ad code never runs,
# the cookie banner never appears, and nothing of Google's is fetched — which
# is what every build should do until the site is approved. Fill both in on
# the host that serves the real domain, not here.
#
#   VITE_ADSENSE_CLIENT   the publisher id, "ca-pub-…"
#   VITE_ADSENSE_SLOT     the responsive ad unit the slots render
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT=
